 #import "FLEXUtility.h"
 #import <objc/runtime.h>
 
+static UIViewController *FLEXVisibleChildController(UIViewController *controller) {
+    if ([controller isKindOfClass:UINavigationController.class]) {
+        return ((UINavigationController *)controller).visibleViewController;
+    }
+    if ([controller isKindOfClass:UITabBarController.class]) {
+        return ((UITabBarController *)controller).selectedViewController;
+    }
+    if ([controller isKindOfClass:UISplitViewController.class]) {
+        return ((UISplitViewController *)controller).viewControllers.lastObject;
+    }
+    for (UIViewController *child in controller.childViewControllers.reverseObjectEnumerator) {
+        if (child.isViewLoaded && child.view.window && !child.view.hidden) {
+            return child;
+        }
+    }
+    return nil;
+}
+
+/// Finds the root of the deepest presentation, including a presentation made
+/// by a visible child of another presented controller. The stock FLEX delegate
+/// only knows about the first tool sheet, while AllFLEXing can present its
+/// workspace from the globals table inside that sheet.
+static UIViewController *FLEXTopmostPresentedController(UIViewController *root) {
+    UIViewController *cursor = root;
+    UIViewController *topmostPresented = nil;
+    for (NSUInteger depth = 0; cursor && depth < 32; depth++) {
+        UIViewController *presented = cursor.presentedViewController;
+        if (presented && !presented.isBeingDismissed) {
+            topmostPresented = presented;
+            cursor = presented;
+            continue;
+        }
+        UIViewController *child = FLEXVisibleChildController(cursor);
+        if (!child || child == cursor) {
+            break;
+        }
+        cursor = child;
+    }
+    return topmostPresented;
+}
+
+@interface FLEXWindow ()
+- (BOOL)flex_pointIsInsidePresentedHierarchy:(CGPoint)point
+                                    withEvent:(UIEvent *)event;
+@end
