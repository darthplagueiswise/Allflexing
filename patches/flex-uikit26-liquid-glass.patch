 @implementation FLEXWindow
 
 - (id)initWithFrame:(CGRect)frame {
@@ -24,9 +70,53 @@
 }
 
 - (BOOL)pointInside:(CGPoint)point withEvent:(UIEvent *)event {
+    // Capture the complete visible frame of the deepest modal before falling
+    // back to FLEX's pass-through toolbar policy. This includes the floating
+    // UITabBar of a nested page sheet, which otherwise forwards touches to the
+    // host application's window even though it is visibly above that window.
+    if ([self flex_pointIsInsidePresentedHierarchy:point withEvent:event]) {
+        return YES;
+    }
     return [self.eventDelegate shouldHandleTouchAtPoint:point];
 }
 
+- (BOOL)flex_pointIsInsidePresentedHierarchy:(CGPoint)point
+                                    withEvent:(UIEvent *)event {
+    UIViewController *presented = FLEXTopmostPresentedController(self.rootViewController);
+    UIPresentationController *presentation = presented.presentationController;
+    UIView *presentedView = presentation.presentedView ?: presented.viewIfLoaded;
+    if (!presentedView || presentedView.hidden || presentedView.alpha < 0.01) {
+        return NO;
+    }
+
+    // Modal presentations own their backdrop as well as the presented frame.
+    // A sheet becomes intentionally nonmodal only when it explicitly declares
+    // an undimmed detent. Keep every other presentation container in FLEX's
+    // window so UIKit's dimming/dismissal view receives the event rather than
+    // the host app below it.
+    BOOL ownsModalBackdrop = YES;
+    if ([presentation isKindOfClass:UISheetPresentationController.class]) {
+        ownsModalBackdrop =
+            ((UISheetPresentationController *)presentation)
+                .largestUndimmedDetentIdentifier == nil;
+    }
+    if (ownsModalBackdrop) {
+        UIView *container = presentation.containerView;
+        if (container) {
+            CGPoint containerPoint = [container convertPoint:point fromView:self];
+            if ([container pointInside:containerPoint withEvent:event]) {
+                return YES;
+            }
+        }
+    }
+
+    CGPoint localPoint = [presentedView convertPoint:point fromView:self];
+    if (![presentedView pointInside:localPoint withEvent:event]) {
+        return NO;
+    }
+    return [presentedView hitTest:localPoint withEvent:event] != nil;
+}
